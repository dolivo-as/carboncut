{
  "name": "@carboncut/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "db:migrate": "wrangler d1 migrations apply carboncut --local",
    "db:seed": "wrangler d1 execute carboncut --local --file=seed/seed.sql",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:demo": "wrangler d1 execute carboncut --local --file=seed/demo_reiser.sql"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@cloudflare/workers-types": "^5.20261114.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.162.0"
  }
}
